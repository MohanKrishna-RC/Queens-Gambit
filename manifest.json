{
  "manifest_version": 3,
  "name": "Chess Game",
  "version": "1.0.0",
  "description": "Play a full game of chess in your browser - two players on one screen or against the computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Open Chess"
  },
  "background": {
    "service_worker": "background.js"
  }
}
